# Copy to .env.local and fill in. .env.local is gitignored. Never commit real values.
# Defaults below are public facts (Telegraph testnet), not secrets.

# --- Telegraph testnet (public) ---
TELEGRAPH_NODE=https://devnode.telegraphprotocol.com
TELEGRAPH_CHAIN_ID=11155111
TELEGRAPH_DIAMOND=0x72a70e949362670Bf8bceAd24eFC5b8f950aa08b
TELEGRAPH_USDC=0xcc194e1a843B658526D0D5C431f670028582Ae17

# --- Keys and endpoints Kinnoski provides (section 16 of the build instruction) ---
# Sepolia RPC. Empty means the public node https://ethereum-sepolia-rpc.publicnode.com is used.
SEPOLIA_RPC_URL=
# House wallet: signs paid asks for the judge door and the probe. Holds test USDC in escrow and a little Sepolia ETH.
HOUSE_PRIVATE_KEY=
# Wallet that pays gas for voyage-key transactions (setMyChargeLimit, withdraw sweeps).
GAS_FUNDER_KEY=
# 12-word mnemonic generated offline. Derives voyage keys at m/44'/60'/0'/0/{voyageIndex}. Vercel env only.
WATCH_MASTER_MNEMONIC=
# Random secret for the tick route: openssl rand -hex 32. Same value in Vercel env and the GitHub Actions secret.
WATCH_TICK_SECRET=
# Neon Postgres connection string (Vercel Marketplace).
DATABASE_URL=
# Reown (WalletConnect) project id for the wallet modal.
NEXT_PUBLIC_REOWN_PROJECT_ID=
# Optional: email alerts (Resend free tier).
RESEND_API_KEY=

# --- Public data sources ---
# Digitraffic asks clients to identify themselves.
DIGITRAFFIC_USER=wharfinger/0.1 (github.com/0xkinno/wharfinger)

# --- Probe only (Phase 1). Optional: a separate mnemonic for probe voyage keys. Generated into .env.local by scripts/probe-paid.ts if empty.
PROBE_MNEMONIC=

# --- Probe only: throwaway house wallet for Phase 1, generated by scripts/gen-probe-wallet.ts. Replace with HOUSE_PRIVATE_KEY for real use.
PROBE_HOUSE_PRIVATE_KEY=
